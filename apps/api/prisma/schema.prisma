generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  passwordHash   String
  displayName    String?
  heightCm       Float?
  createdAt      DateTime @default(now())

  consents       ConsentRecord[]
  jumps          JumpMeasurement[]
  recoveryCheckins RecoveryCheckin[]
}

// A user cannot record a jump without an active anonymized_data_research
// consent — enforced at the API layer before any JumpMeasurement write.
model ConsentRecord {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  scope      String
  version    String
  acceptedAt DateTime @default(now())
  revokedAt  DateTime?

  @@index([userId, scope])
}

model JumpMeasurement {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  type              String
  heightCm          Float
  flightTimeMs      Float
  contactTimeMs     Float?
  // Landing knee valgus proxy: horizontal deviation of the knee from the
  // hip-ankle line at landing, normalized by shank length. Higher = more
  // inward knee collapse, a known ACL-injury-risk marker. Null until the
  // frontend lands a frame with both knees clearly visible.
  leftKneeValgusRatio  Float?
  rightKneeValgusRatio Float?
  capturedAt        DateTime @default(now())

  @@index([userId, capturedAt])
}

// One check-in per day per user (enforced at the API layer, not a DB
// constraint, so a resubmission on the same day overwrites rather than
// errors — matches how a "how do you feel today" form is actually used).
model RecoveryCheckin {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  sorenessLevel Int      // 1 (none) - 5 (severe)
  sleepHours    Float
  rpe           Int      // session RPE 1-10, previous day's training
  checkedAt     DateTime @default(now())

  @@index([userId, checkedAt])
}
